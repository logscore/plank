  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["scripts/**/*.{js,cjs,mjs,jsx,ts,tsx,mts,cts}"],
  "project": ["**/*.{js,cjs,mjs,jsx,ts,tsx,mts,cts,svelte}"],
  "ignore": ["site/**"],
  "ignoreDependencies": ["tailwindcss"],
  "ignoreBinaries": ["svelte-check-rs"],
